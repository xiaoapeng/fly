choice FLY_PROJECT_LINUX
    depends on ARCH_X64_LINUX

config PROJECT_EHIP_TEST
    bool "EHIP test project"
    help
        Select this option to enable Module EHIP TEST.
    select PACKAGE_SCHEDULER_REQUIRE_EVENTHUB_OS
    select PACKAGE_EHIP
    select PACKAGE_EHSHELL
    select PACKAGE_ARGUMENT_PARSER

endchoice

config PROJECT
    string
    default "linux/ehip-test" if PROJECT_EHIP_TEST
