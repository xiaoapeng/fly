choice FLY_PROJECT_GD32F10X
    depends on ARCH_GD32F10X

config PROJECT_GD32F105_DEMO
    bool "GD32F105 demo project"
    help
        Select this option to enable Module GD32F105 DEMO.
    select PACKAGE_SCHEDULER_REQUIRE_EVENTHUB_OS
    select PACKAGE_SEGGER_RTT

endchoice

config PROJECT
    string
    default "gd32f10x/gd32f105-demo" if PROJECT_GD32F105_DEMO
