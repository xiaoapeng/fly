    bool "MCXN947 demo project"
    help
        Select this option to enable Module MCXN947 DEMO.
    select PACKAGE_SCHEDULER_REQUIRE_EVENTHUB_OS
    select PACKAGE_SEGGER_RTT

endchoice

config PROJECT
    string
    default "mcxn947/mcxn947-demo" if PROJECT_MCXN947_DEMO
