CONFIG_PROJECT_MCXN947_FREERTOS_DEMO=y
CONFIG_PACKAGE_SCHEDULER_FREERTOS=y
CONFIG_PACKAGE_NANOSIG=y
# Board runs at 150 MHz (BOARD_BOOTCLOCKPLL150M_CORE_CLOCK in clock_config.c);
# the FreeRTOS SysTick must match or all delays scale wrong.
CONFIG_PACKAGE_FREERTOS_SYSTICK_CLOCK_HZ=150000000
# nanosig demo adds loop/emit tasks (2KB + 1KB stacks) plus the broker task
# and ns allocations from the FreeRTOS heap; the 8 KB default is not enough.
CONFIG_PACKAGE_FREERTOS_TOTAL_HEAP_SIZE=32768