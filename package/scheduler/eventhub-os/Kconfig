# eventhub-os sub-config. The scheduler choice
# PACKAGE_SCHEDULER_EVENTHUB_OS is the user-facing entry point; this
# file only contributes the global timer signal tunables under that
# choice and is pulled in by package/scheduler/Kconfig::rsource.

if PACKAGE_SCHEDULER_EVENTHUB_OS

menuconfig PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL
    bool "eventhub global timer signal"
    default n
if PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL

config PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL_1S
    bool "eventhub global timer signal 1s"
    default n

config PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL_500MS
    bool "eventhub global timer signal 500ms"
    default n

config PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL_100MS
    bool "eventhub global timer signal 100ms"
    default n

endif # PACKAGE_EVENTHUB_GLOBAL_TIMER_SIGNAL

endif # PACKAGE_SCHEDULER_EVENTHUB_OS