function(app_add_jlink_image image_target)
    if(NOT FLY_JLINK_DEVICE OR NOT DEFINED FLY_FLASH_ADDRESS)
        return()
    endif()
    if(NOT FLY_FLASH_SIZE)
        message(FATAL_ERROR "J-Link image packaging requires the board's FLY_FLASH_SIZE.")
    endif()

    add_jlink_image("${image_target}" CHIP_NAME "${FLY_JLINK_DEVICE}" ${ARGN})
endfunction()
