    },
    {
      "name": "debug",
      "provider": "renode",
      "handler": "tool/packs/tool/renode/actions.py",
      "inputs": [
        "artifact"
      ],
      "help": "启动暂停的仿真并用归档 ELF 调试",
      "tool_check": "tool/packs/tool/renode/actions.py",
      "debug_profiles": [
        {
          "id": "archive",
          "input": "artifact",
          "mode": "start",
          "server": "owned",
          "after_connect": [
