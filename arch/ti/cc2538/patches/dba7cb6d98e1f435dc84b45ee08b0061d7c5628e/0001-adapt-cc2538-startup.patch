-void
-default_handler(void)
+
+void SystemInit(void)
 {
-  while(1);
+    /* SYS_CTRL.EMUOVR: restore the documented reset value from TI SWRU319C. */
+    *(volatile uint32_t *)UINT32_C(0x400D20B4) = UINT32_C(0xFF);
 }
-/*---------------------------------------------------------------------------*/
-void
-reset_handler(void)
-{
-  REG(SYS_CTRL_EMUOVR) = 0xFF;
-
-  /* Copy the data segment initializers from flash to SRAM. */
-  rom_util_memcpy(&_data, &_ldata, &_edata - &_data);
 
-  /* Zero-fill the bss segment. */
-  rom_util_memset(&_bss, 0, &_ebss - &_bss);
+void Reset_Handler(void)
+{
+    memcpy(&_sdata, &_sidata, (uintptr_t)&_edata - (uintptr_t)&_sdata);
+    memset(&_sbss, 0, (uintptr_t)&_ebss - (uintptr_t)&_sbss);
 
-  /* call the application's entry point. */
-  main();
+    SystemInit();
+    *(volatile uint32_t *)UINT32_C(0xE000ED08) = (uintptr_t)cc2538_vectors;
+    __asm__ volatile ("dsb\nisb" ::: "memory");
 
-  /* End here if main () returns */
-  while(1);
+    __libc_init_array();
+    (void)main();
+    Default_Handler();
 }
