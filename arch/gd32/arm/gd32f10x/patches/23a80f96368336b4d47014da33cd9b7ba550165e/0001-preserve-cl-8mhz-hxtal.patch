diff --git a/Firmware/CMSIS/GD/GD32F10x/Source/system_gd32f10x.c b/Firmware/CMSIS/GD/GD32F10x/Source/system_gd32f10x.c
index cc99d33..6276203 100644
--- a/Firmware/CMSIS/GD/GD32F10x/Source/system_gd32f10x.c
+++ b/Firmware/CMSIS/GD/GD32F10x/Source/system_gd32f10x.c
@@ -809,9 +809,12 @@ static void system_clock_108m_hxtal(void)
     RCU_CFG0 &= ~(RCU_CFG0_PLLMF | RCU_CFG0_PLLMF_4);
     RCU_CFG0 |= (RCU_PLLSRC_HXTAL | RCU_PLL_MUL27);
 
-    /* CK_PREDIV0 = (CK_HXTAL)/5 *8 /10 = 4 MHz */ 
+    /* Select divisors that produce 4 MHz from either 8 MHz or 25 MHz HXTAL. */
+    const uint32_t prediv = HXTAL_VALUE == 8000000U
+        ? (RCU_PREDV1_DIV8 | RCU_PREDV0_DIV2)
+        : (RCU_PREDV1_DIV5 | RCU_PREDV0_DIV10);
     RCU_CFG1 &= ~(RCU_CFG1_PREDV0SEL | RCU_CFG1_PLL1MF | RCU_CFG1_PREDV1 | RCU_CFG1_PREDV0);
-    RCU_CFG1 |= (RCU_PREDV0SRC_CKPLL1 | RCU_PLL1_MUL8 | RCU_PREDV1_DIV5 | RCU_PREDV0_DIV10);
+    RCU_CFG1 |= (RCU_PREDV0SRC_CKPLL1 | RCU_PLL1_MUL8 | prediv);
 
     /* enable PLL1 */
     RCU_CTL |= RCU_CTL_PLL1EN;
